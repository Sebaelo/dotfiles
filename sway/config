## Variables

set $mod Mod4
set $alt Mod1

set $left h
set $down j
set $up k
set $right l

set $term alacritty
set $menu rofi -show drun
set $files nautilus
set $browser brave-origin

### Output configuration
#
# Default wallpaper (more resolutions are available in /usr/share/backgrounds/sway/)
output * bg ~/Wallpapers/forest-sunset.jpg fill
#
# Example configuration:
#
#   output HDMI-A-1 resolution 1920x1080 position 1920,0
#
# You can get the names of your outputs by running: swaymsg -t get_outputs

### Idle configuration

# Example configuration:

exec swayidle -w \
         timeout 300 'swaylock -f -c 000000' \
         timeout 600 'swaymsg "output * power off"' resume 'swaymsg "output * power on"; gammastep -PO 3200' \
         before-sleep 'swaylock -f -c 000000'
#
# This will lock your screen after 300 seconds of inactivity, then turn off
# your displays after another 300 seconds, and turn your screens back on when
# resumed. It will also lock your screen before your computer goes to sleep.

   input type:keyboard {
       xkb_layout "se"
   }

### Key bindings

# Basics:

    bindsym $mod+w kill
    bindsym $mod+Return exec $term
    bindsym $mod+space exec $menu
    bindsym $mod+f exec $files
    bindsym $mod+b exec $browser
    bindsym $mod+o exec obsidian

    # Reload the configuration file
    bindsym $mod+Shift+c reload

# Move focus:

    bindsym $mod+$left focus left
    bindsym $mod+$down focus down
    bindsym $mod+$up focus up
    bindsym $mod+$right focus right

# Swap windows:

    bindsym $mod+Shift+$left mark swap, focus left, swap container with mark swap, focus left, unmark swap
    bindsym $mod+Shift+$down mark swap, focus down, swap container with mark swap, focus down, unmark swap
    bindsym $mod+Shift+$up mark swap, focus up, swap container with mark swap, focus up, unmark swap
    bindsym $mod+Shift+$right mark swap, focus right, swap container with mark swap, focus right, unmark swap

# Move windows:
    bindsym $mod+shift+left move left
    bindsym $mod+shift+down move down
    bindsym $mod+shift+up move up
    bindsym $mod+shift+right move right

# Workspaces:

    # Switch to workspace
    bindsym $alt+1 workspace number 1
    bindsym $alt+2 workspace number 2
    bindsym $alt+3 workspace number 3
    bindsym $alt+4 workspace number 4

    bindsym $alt+Shift+1 move container to workspace number 1
    bindsym $alt+Shift+2 move container to workspace number 2
    bindsym $alt+Shift+3 move container to workspace number 3
    bindsym $alt+Shift+4 move container to workspace number 4

    bindsym $mod+m fullscreen

    # Swap focus between the tiling area and the floating area
    bindsym $alt+space focus mode_toggle

# Move floating windows
floating_modifier $mod normal

# Toggle split orientation
bindsym $mod+e layout toggle split

mode "resize" {
    bindsym $left resize shrink width 25px
    bindsym $down resize grow height 25px
    bindsym $up resize shrink height 25px
    bindsym $right resize grow width 25px

    bindsym Left resize shrink width 25px
    bindsym Down resize grow height 25px
    bindsym Up resize shrink height 25px
    bindsym Right resize grow width 25px

    # Return to default mode
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

# Utilities:
    # Special keys to adjust volume via PulseAudio
    bindsym --locked XF86AudioMute exec pactl set-sink-mute \@DEFAULT_SINK@ toggle
    bindsym --locked XF86AudioLowerVolume exec pactl set-sink-volume \@DEFAULT_SINK@ -10%
    bindsym --locked XF86AudioRaiseVolume exec pactl set-sink-volume \@DEFAULT_SINK@ +10%
    bindsym --locked XF86AudioMicMute exec pactl set-source-mute \@DEFAULT_SOURCE@ toggle

    # Special keys to control media via playerctl
    bindsym --locked XF86AudioPlay exec playerctl play-pause
    bindsym --locked XF86AudioPause exec playerctl play-pause
    bindsym --locked XF86AudioPrev exec playerctl previous
    bindsym --locked XF86AudioNext exec playerctl next
    bindsym --locked XF86AudioStop exec playerctl stop

    # Special keys to adjust brightness via DDC/CI
    bindsym --locked $alt+XF86AudioLowerVolume exec ddcutil setvcp 10 - 20 --sleep-multiplier 2
    bindsym --locked $alt+XF86AudioRaiseVolume exec ddcutil setvcp 10 + 20

    # Special key to take a screenshot
    bindsym $alt+XF86AudioMute exec geom=$(slurp) && grim -g "$geom" - \
      | tee ~/Pictures/screenshot_$(date +'%Y-%m-%d_%H-%M-%S').png \
      | wl-copy && notify-send "Screenshot saved"

# Styling:
gaps inner 5
default_border pixel 2
client.focused #7dc4e4 #24273a #cad3f5 #7dc4e4 #7dc4e4

#
# Status Bar:
#
bar {
    swaybar_command waybar
}

exec /usr/lib/mate-polkit/polkit-mate-authentication-agent-1
exec autotiling
exec mako
exec dropbox

exec_always gammastep -PO 3200
exec_always gsettings set org.gnome.desktop.interface color-scheme prefer-dark
exec_always gsettings set org.gnome.desktop.interface gtk-theme 'Adwaita'
exec_always wl-copy "" # Stop nvim from complaining nothing is copied after boot

include /etc/sway/config.d/*
